<Window x:Class="AudioStretch.MapsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Dynamic maps - AudioStretch">
 <Grid x:Name="Root" Background="{ThemeResource JupiterWindowBrush}" Padding="24" RowSpacing="16">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Spacing="8"><TextBlock Text="Dynamic maps" Style="{StaticResource JupiterPageHeadingTextStyle}"/><TextBlock x:Name="SourceDetails" Style="{StaticResource JupiterCaptionTextStyle}" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Spacing="16"><ComboBox x:Name="Kind" Header="Map" SelectedIndex="0" SelectionChanged="KindChanged"><ComboBoxItem Content="Time anchors · Offline"/><ComboBoxItem Content="Pitch offsets · Real-time"/><ComboBoxItem Content="Frequency ratios · Real-time"/></ComboBox><ComboBox x:Name="Units" Header="Position units" SelectedIndex="0" SelectionChanged="UnitsChanged"><ComboBoxItem Content="Sample frames"/><ComboBoxItem Content="Seconds"/></ComboBox></StackPanel></StackPanel>
  <StackPanel Grid.Row="1" Spacing="8"><TextBlock x:Name="ColumnHelp" Style="{StaticResource JupiterBodyTextStyle}" TextWrapping="Wrap"/><TextBlock Text="Seconds round to the nearest sample frame (half up). Positions must increase strictly. Pitch offsets are relative to the initial pitch. Time maps use the total duration in the main window; pitch maps force real-time file rendering." Style="{StaticResource JupiterCaptionTextStyle}" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Add row" Click="AddClicked"/><Button Content="Import text…" Click="ImportClicked"/><Button Content="Export text…" Click="ExportClicked"/><Button Content="Validate" Click="ValidateClicked"/></StackPanel></StackPanel>
  <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"><StackPanel Spacing="16"><ItemsControl x:Name="Rows"><ItemsControl.ItemTemplate><DataTemplate><Grid ColumnSpacing="8" Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding Source, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Source position" AutomationProperties.Name="Source position"/><TextBox Grid.Column="1" Text="{Binding Target, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Destination or shift" AutomationProperties.Name="Destination or shift"/><Button Grid.Column="2" Content="Remove" Click="RemoveClicked"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><InfoBar x:Name="ErrorBar" Severity="Error" IsOpen="False"/><TextBlock x:Name="PlanSummary" Style="{StaticResource JupiterBodyTextStyle}" TextWrapping="Wrap"/><TextBox x:Name="Preview" Header="Normalized native map (frames)" IsReadOnly="True" AcceptsReturn="True" FontFamily="{StaticResource JupiterMonoFontFamily}" TextWrapping="NoWrap" MinHeight="96"/></StackPanel></ScrollViewer>
  <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8"><Button Content="Apply map" Style="{StaticResource AccentButtonStyle}" Click="ApplyClicked"/><Button Content="Close" Click="CloseClicked"/></StackPanel>
 </Grid>
</Window>
