<Window x:Class="AudioStretch.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="AudioStretch">
 <Grid x:Name="Root" Background="{ThemeResource JupiterWindowBrush}" AllowDrop="True" DragOver="RootDragOver" Drop="RootDrop">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid.KeyboardAccelerators>
   <KeyboardAccelerator Key="O" Modifiers="Control" Invoked="OpenShortcut"/>
   <KeyboardAccelerator Key="F5" Invoked="ExportShortcut"/>
  </Grid.KeyboardAccelerators>
  <MenuBar>
   <MenuBarItem Title="File">
    <MenuFlyoutItem Text="Open…" Click="OpenClicked" KeyboardAcceleratorTextOverride="Ctrl+O"/>
    <MenuFlyoutItem Text="Export…" Click="ExportClicked" KeyboardAcceleratorTextOverride="F5"/>
    <MenuFlyoutSeparator/>
    <MenuFlyoutItem Text="Settings" Click="SettingsClicked" KeyboardAcceleratorTextOverride="Ctrl+,"/>
    <MenuFlyoutSeparator/><MenuFlyoutItem Text="Exit" Click="ExitClicked"/>
   </MenuBarItem>
   <MenuBarItem Title="Audio">
    <MenuFlyoutItem Text="Play source" Click="PlaySourceClicked"/>
    <MenuFlyoutItem Text="Play output" Click="PlayOutputClicked"/>
    <MenuFlyoutItem Text="Stop playback" Click="StopClicked"/>
    <MenuFlyoutSeparator/><MenuFlyoutItem Text="Cancel render" Click="CancelClicked"/>
   </MenuBarItem>
   <MenuBarItem Title="Help"><MenuFlyoutItem Text="Check for updates…" Click="SettingsClicked"/><MenuFlyoutItem Text="About AudioStretch" Click="AboutClicked"/></MenuBarItem>
  </MenuBar>
  <ScrollViewer x:Name="FormScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto">
   <StackPanel Padding="24" Spacing="16" Width="{Binding ActualWidth, ElementName=FormScroll}" MaxWidth="688" HorizontalAlignment="Left">
    <InfoBar x:Name="MessageBar" IsOpen="False" IsClosable="True"><InfoBar.ActionButton><Button x:Name="SetupTools" Content="Install audio tools…" Click="SetupToolsClicked" Visibility="Collapsed"/></InfoBar.ActionButton></InfoBar>
    <Grid ColumnSpacing="8">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBox x:Name="SourcePath" Header="Source audio" IsReadOnly="True" PlaceholderText="Open an audio file or drop it here" MinWidth="240"/>
     <Button x:Name="OpenButton" Grid.Column="1" Content="Open…" Click="OpenClicked" VerticalAlignment="Bottom"/>
    </Grid>
    <TextBlock x:Name="SourceInfo" Text="No audio loaded" Style="{StaticResource JupiterCaptionTextStyle}" TextWrapping="Wrap"/>
    <Grid ColumnSpacing="16">
     <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <TextBox x:Name="Tempo" Header="Tempo (%)" Text="5" TextChanged="TempoChanged" LostFocus="TempoLostFocus" InputScope="Number"/>
     <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Spacing="4">
      <Slider x:Name="TempoSlider" Minimum="-75" Maximum="300" StepFrequency="0.1" Value="5" ValueChanged="SliderChanged" AutomationProperties.Name="Tempo change"/>
      <TextBlock x:Name="TempoSummary" Style="{StaticResource JupiterCaptionTextStyle}" TextWrapping="Wrap"/>
     </StackPanel>
    </Grid>
    <TextBlock x:Name="TempoError" Visibility="Collapsed" Style="{StaticResource JupiterCaptionTextStyle}" Foreground="{ThemeResource JupiterErrorBrush}" Text="⚠ Enter a tempo change between -75% and +300%." TextWrapping="Wrap"/>
    <TextBlock Text="Pitch unchanged · Rubber Band R3/Finer" Style="{StaticResource JupiterCaptionTextStyle}" TextWrapping="Wrap"/>
    <Grid ColumnSpacing="16">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <ComboBox x:Name="Format" Header="Output format" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="ExportChoiceChanged"><ComboBoxItem Content="WAV"/><ComboBoxItem Content="FLAC"/></ComboBox>
     <ComboBox x:Name="Precision" Grid.Column="1" Header="Sample precision" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="ExportChoiceChanged"><ComboBoxItem Content="32-bit float" Tag="float"/><ComboBoxItem Content="24-bit" Tag="24"/><ComboBoxItem Content="16-bit" Tag="16"/></ComboBox>
    </Grid>
    <Grid ColumnSpacing="8">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBox x:Name="OutputPath" Header="Output file" TextChanged="OutputChanged"/>
     <Button x:Name="OutputBrowse" Grid.Column="1" Content="Browse…" Click="OutputBrowseClicked" VerticalAlignment="Bottom"/>
    </Grid>
    <TextBlock Text="Original sample rate and channels. Tags and artwork are not copied." Style="{StaticResource JupiterCaptionTextStyle}" TextWrapping="Wrap"/>
    <StackPanel Orientation="Horizontal" Spacing="8">
     <Button x:Name="PlaySource" Content="Play source" Click="PlaySourceClicked" IsEnabled="False"/>
     <Button x:Name="PlayOutput" Content="Play output" Click="PlayOutputClicked" IsEnabled="False"/>
     <Button Content="Stop playback" Click="StopClicked"/>
    </StackPanel>
    <TextBlock x:Name="PlaybackLabel" Style="{StaticResource JupiterCaptionTextStyle}" TextWrapping="Wrap" Visibility="Collapsed"/>
    <MediaPlayerElement x:Name="Player" AreTransportControlsEnabled="True" Visibility="Collapsed" Height="96"/>
    <Expander Header="Processing log" HorizontalAlignment="Stretch">
     <StackPanel Spacing="8"><Button Content="Copy log" Click="CopyLogClicked" HorizontalAlignment="Left"/>
      <TextBox x:Name="Log" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="240" FontFamily="{StaticResource JupiterMonoFontFamily}" FontSize="{StaticResource JupiterCaptionFontSize}" AutomationProperties.Name="Processing log"/>
     </StackPanel>
    </Expander>
   </StackPanel>
  </ScrollViewer>
  <StackPanel Grid.Row="2" Padding="24,12" Spacing="8">
   <StackPanel Orientation="Horizontal" Spacing="8">
    <Button x:Name="ExportButton" Content="Export…" Style="{StaticResource AccentButtonStyle}" Click="ExportClicked" IsEnabled="False"/>
    <Button x:Name="CancelButton" Content="Cancel render" Click="CancelClicked" IsEnabled="False"/>
   </StackPanel>
   <TextBlock x:Name="ProgressText" Text="Choose audio to begin." Style="{StaticResource JupiterBodyTextStyle}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
   <ProgressBar x:Name="Progress" Visibility="Collapsed" IsIndeterminate="True"/>
  </StackPanel>
  <Border Grid.Row="3" Background="{ThemeResource JupiterSurfaceBrush}" BorderBrush="{ThemeResource JupiterSeparatorBrush}" BorderThickness="0,1,0,0" Padding="12,0" MinHeight="32">
   <TextBlock x:Name="Status" Text="Ready" Style="{StaticResource JupiterCaptionTextStyle}" VerticalAlignment="Center" TextWrapping="Wrap"/>
  </Border>
 </Grid>
</Window>
